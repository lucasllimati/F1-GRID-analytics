# ── Banco de dados ────────────────────────────────────────────────
# Desenvolvimento: SQLite local (padrão abaixo).
# Produção: PostgreSQL (Neon) — veja docs/DEPLOY.md. Lá, DATABASE_URL é a conexão com pooler
# e DIRECT_URL a conexão direta (usada pelas migrations).
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# ── Site ──────────────────────────────────────────────────────────
SITE_URL="http://localhost:3000"

# ── Segurança ─────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Token exigido pelo endpoint de cron (/api/cron/news). Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── Redação com IA ────────────────────────────────────────────────
# Sem IA configurada, o sistema apenas monitora as fontes e agrupa pautas.
# Provedor: anthropic | gemini | openai_compatible
NEWS_AI_PROVIDER="gemini"
# Vazio = padrão do provedor (gemini-3.8-flash / claude-opus-5-5)
NEWS_AI_MODEL=""

# Google Gemini (plano gratuito para testes): https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Anthropic Claude (recomendado para produção): https://platform.claude.com
ANTHROPIC_API_KEY=""

# Cadeia de reserva: quando o provedor principal falha (cota, sobrecarga, rede), a tarefa vai
# para o próximo. Vazio = padrão (com Gemini: gemini-3.6-flash → gemini-3.5-flash-lite e, se
# houver OPENROUTER_API_KEY, um modelo gratuito do OpenRouter no fim). "none" desliga.
# Formato: provedor:modelo,provedor:modelo  (provedores: gemini, openrouter, groq, anthropic, openai_compatible)
NEWS_AI_FALLBACKS=""
# OpenRouter (modelos ":free" gratuitos, outra empresa — protege contra instabilidade do Google):
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""
# Groq (opcional; informe o modelo em NEWS_AI_FALLBACKS, ex.: groq:NOME_DO_MODELO)
GROQ_API_KEY=""

# Qualquer API compatível com OpenAI (Ollama, Groq, OpenRouter…)
NEWS_AI_BASE_URL=""
NEWS_AI_API_KEY=""

# Modo de publicação: manual | semi | auto_restricted
#  manual          -> IA não roda; editores escrevem/aprovam tudo.
#  semi            -> IA redige e checa; tudo vai para revisão humana.
#  auto_restricted -> publica sozinho SOMENTE se passar em todos os critérios
#                     (fontes independentes, fatos verificados, tema não sensível,
#                     sem cópia). O resto vai para revisão humana.
NEWS_PUBLISH_MODE="semi"

# Limites de custo por ciclo e por dia
NEWS_MAX_ARTICLES_PER_RUN="3"
NEWS_MAX_ARTICLES_PER_DAY="24"

# ── Produção (opcional) ───────────────────────────────────────────
# Botão "Buscar e escrever notícias" do painel dispara o GitHub Actions (sem limite de 5 min).
# Token fine-grained, só deste repositório, permissão "Actions: Read and write".
GITHUB_REPOSITORY=""
GITHUB_DISPATCH_TOKEN=""

# Nível de log (debug | info | warn | error)
LOG_LEVEL="info"
