# ── Banco de dados ────────────────────────────────────────────────
# Desenvolvimento: SQLite local. Produção: veja docs/DEPLOY.md (PostgreSQL).
DATABASE_URL="file:./dev.db"

# ── Site ──────────────────────────────────────────────────────────
SITE_URL="http://localhost:3000"

# ── Segurança ─────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Token exigido pelo endpoint de cron (/api/cron/news). Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── Redação com IA (Anthropic) ────────────────────────────────────
# Sem chave, o sistema apenas monitora as fontes e agrupa pautas; nada é redigido.
ANTHROPIC_API_KEY=""
NEWS_AI_MODEL="claude-opus-5-5"

# Modo de publicação: manual | semi | auto_restricted
#  manual          -> IA não roda; editores escrevem/aprovam tudo.
#  semi            -> IA redige e checa; tudo vai para revisão humana.
#  auto_restricted -> publica sozinho SOMENTE se passar em todos os critérios
#                     (fontes independentes, fatos verificados, tema não sensível,
#                     sem cópia). O resto vai para revisão humana.
NEWS_PUBLISH_MODE="auto_restricted"

# Limites de custo por ciclo e por dia
NEWS_MAX_ARTICLES_PER_RUN="3"
NEWS_MAX_ARTICLES_PER_DAY="24"
